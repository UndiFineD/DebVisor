{
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.pythonProjects": [
        {
            "path": "${workspaceFolder}",
            "pythonPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "type": "venv",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    // Ensure VS Code uses the workspace .venv interpreter
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    // Exclude .venv from YAML validation (METADATA files aren't YAML)
    // Also force the correct schema for markdownlint-cli2 config files.
    "yaml.schemas": {
        "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.20.0/schema/markdownlint-cli2-config-schema.json": ".markdownlint-cli2.yaml"
    },
    "files.exclude": {
        "**/.venv": false
    },
    "search.exclude": {
        "**/.venv": true
    },
    "yaml.validate": true,
    "yaml.customTags": [],
    "files.associations": {
        "**/.venv/**/METADATA": "plaintext",
        "**/.venv/**/*.dist-info/METADATA": "plaintext",
        "**/.venv/**/*.dist-info/RECORD": "plaintext",
        "**/.venv-*/**/*.dist-info/RECORD": "plaintext",
        "**/.venv-*/**/*.dist-info/METADATA": "plaintext",
        "**/*.dist-info/RECORD": "plaintext"
    },
    // Completely exclude .venv from language servers
    "redhat.telemetry.enabled": false,
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    // Exclude patterns from file watchers to improve performance
    "files.watcherExclude": {
        "**/.venv/**": true
    },
    "markdownlint.ignore": [
        "**/.venv/**",
        "**/.venv-*/**",
        "**/site-packages/**",
        "**/*.dist-info/**"
    ]
}
