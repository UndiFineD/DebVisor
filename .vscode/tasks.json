{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/master/extensions/git/resources/schemas/tasks.schema.json",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run fixer tests",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "scripts/test_fix_markdown_lint.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Markdown scan (PyMarkdown)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pymarkdown",
        "--config",
        "pymarkdown.json",
        "scan",
        "-r",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run fix_markdown_lint",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "fix_markdown_lint.py",
        "improvements.md"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Activate venv (PowerShell)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\Activate.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run agent tests (tests)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q",
        "tests/test_agent_base_agent.py",
        "tests/test_agent_subagents.py",
        "tests/test_agent_stats_agent.py",
        "tests/test_agent_generate_agent_reports.py",
        "tests/test_agent_orchestrator.py",
        "tests/test_agent_smoke_imports.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Run agent legacy tests (scripts/agent)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest",
        "-q",
        "scripts/agent/test_agent.py",
        "scripts/agent/test_base_agent.py",
        "scripts/agent/test_agent_changes.py",
        "scripts/agent/test_agent_changes_tests.py",
        "scripts/agent/test_agent_coder.py",
        "scripts/agent/test_agent_context.py",
        "scripts/agent/test_agent_errors.py",
        "scripts/agent/test_agent_improvements.py",
        "scripts/agent/test_agent_stats.py",
        "scripts/agent/test_agent_tests.py",
        "tests/test_agent_legacy_scripts.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Run all agent tests",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Run agent tests (tests)",
        "Run agent legacy tests (scripts/agent)"
      ],
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "showReuseMessage": false,
        "close": true
      }
    }
  ]
}
